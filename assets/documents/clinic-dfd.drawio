        <mxCell id="m4ganlcH29rnpWtC-Hia-7" connectable="0" parent="m4ganlcH29rnpWtC-Hia-4" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="&lt;font style=&quot;font-size: 8px;&quot;&gt;Уведомление о готовности&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px;&quot;&gt;анализов&lt;/font&gt;&lt;/div&gt;" vertex="1">
